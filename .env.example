# Samadhan Connect — Supabase Environment Configuration
# Copy this file to .env and fill in your Supabase project credentials

# Supabase Project URL (From Supabase Dashboard -> Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public Key (Safe for browser client)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
